#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  network:
    ethernets:
      ens33:
        dhcp4: true
    version: 2
  storage:
    layout:
      name: lvm
  identity:
    hostname: packer
    username: packer
    password: "$6$rounds=4096$saltsaltsalt$3kSInlkwN8HkTpawXOJvUO1sPNtI5mB3bWJKoG9GnXkiwmXOe2bFCiOYrMxbNsKuKk2xfmP5lZ1VHx3W0zqm0"
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - curl
    - git
    - vim
    - wget
    - unzip
    - jq
    - ca-certificates
    - apt-transport-https
    - open-vm-tools
  late-commands:
    - echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/packer
    - chmod 440 /target/etc/sudoers.d/packer
